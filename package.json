{
  "name": "@soulfire330/piw",
  "version": "0.0.6",
  "description": "Pi profile manager with TUI and independent per-profile package installation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulfire330/piw.git"
  },
  "keywords": [
    "pi",
    "pi-package",
    "profile",
    "profiles",
    "cli",
    "piw"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "piw": "bin/piw.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin/piw.js",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "bun run --bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format . --write",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "latest",
    "@types/node": "^26.1.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
